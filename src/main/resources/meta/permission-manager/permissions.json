{
    "generics": [
        {
            "name": "view_student_data.$schoolClass.$subject",
            "description": "Allows viewing student data.",
            "paths": [
                "/student",
                "/student-data",
                "/build_student.js",
                "/student-subjects",
                "/current-topic",
                "/topic-list",
                "/tasks"
            ],
            "post_restrictions": [
                {
                    "type": "student",
                    "restriction": "part_of.$schoolClass",
                    "field_missing_behavior": "grant"
                },
                {
                    "type": "subject",
                    "restriction": "is.$subject",
                    "field_missing_behavior": "grant"
                }
            ],
            "depends": [
                "standard_files",
                "view_class_data.$schoolClass"
            ],
            "default": "admin",
            "generate_generic": true
        },
        {
            "name": "change_student_data.$schoolClass.$subject",
            "description": "Allows changing student data.",
            "paths": [
                "/subject-request",
                "/change-current-topic",
                "/complete-task",
                "/cancel-task",
                "/lock-task",
                "/reopen-task",
                "/begin-task"
            ],
            "post_restrictions": [
                {
                    "type": "student",
                    "restriction": "part_of.$schoolClass",
                    "field_missing_behavior": "grant"
                },
                {
                    "type": "subject",
                    "restriction": "is.$subject",
                    "field_missing_behavior": "grant"
                }
            ],
            "depends": [
                "standard_files",
                "view_student_data.$schoolClass.$subject"
            ],
            "default": "admin",
            "generate_generic": true
        },
        {
            "name": "change_student_graduation.$schoolClass",
            "description": "Allows changing a student's graduation.",
            "paths": [
                "/change-graduation-level"
            ],
            "post_restrictions": [
                {
                    "type": "student",
                    "restriction": "part_of.$schoolClass",
                    "field_missing_behavior": "grant"
                }
            ],
            "depends": [
                "standard_files",
                "view_student_data.$schoolClass"
            ],
            "default": "admin",
            "generate_generic": true
        },
        {
            "name": "view_class_data.$schoolClass",
            "description": "Allows viewing class data.",
            "paths": [
                "/class",
                "/student-list"
            ],
            "post_restrictions": [
                {
                    "type": "class",
                    "restriction": "is.$schoolClass",
                    "field_missing_behavior": "grant"
                }
            ],
            "depends": [
                "standard_files",
                "fetch_subjects"
            ],
            "default": "admin",
            "generate_generic": true
        },
        {
            "name": "change_class_data.$schoolClass",
            "description": "Allows changing class data.",
            "paths": [
                "/edit-class",
                "/add-subject-to-class"
            ],
            "post_restrictions": [
                {
                    "type": "class",
                    "restriction": "is.$schoolClass",
                    "field_missing_behavior": "grant"
                }
            ],
            "depends": [
                "standard_files",
                "view_class_data"
            ],
            "default": "admin",
            "generate_generic": true
        }
    ],
    "flat": [
        {
            "name": "login",
            "description": "Allows viewing the login page. Do not remove this from the ANONYMOUS user, or no one may be able to sign in.",
